const SEARCH_DEBOUNCE_MS = 500;
const DISTANCE_CALC_DELAY_MS = 800;

// ✅ Department code that should be treated as "shared" across all departments
const SHARED_DEPARTMENT_CODES = ["MO"]; // Mayor's Office

// ============================================
// SUB-COMPONENTS (unchanged)
