<?php

namespace App\Services;

use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Cache;

class NominatimService
{
    protected $baseUrl;
    protected $fallbackService;
    protected $userAgent;
    protected $country;
    protected $language;
    protected $enabled;

    public function __construct(FallbackLocationService $fallbackService)
    {
        $this->fallbackService = $fallbackService;
        $this->baseUrl = config('services.nominatim.base_url', 'https://nominatim.openstreetmap.org');
        $this->userAgent = config('services.nominatim.user_agent', 'FCMS/1.0');
        $this->country = config('services.nominatim.country', 'ph');
        $this->language = config('services.nominatim.language', 'en');
        $this->enabled = config('services.nominatim.enabled', true);
    }

    /**
     * Search — FALLBACK FIRST, then Nominatim if no local results.
     * NEVER returns failure.
     */
    public function searchPlaces($query, $limit = 10)
    {
        if (empty($query) || strlen($query) < 2) {
            return ['success' => true, 'predictions' => [], 'total' => 0, 'source' => 'empty'];
        }

        // ✅ STEP 1: Try fallback (fast, always works, has real coords)
        $fallbackResult = $this->fallbackService->searchPlaces($query);

        // If fallback found good results, return them immediately
        if (!empty($fallbackResult['predictions'])) {
            Log::info('Search served from fallback', ['query' => $query, 'count' => count($fallbackResult['predictions'])]);
            return $fallbackResult;
        }

        // ✅ STEP 2: Fallback empty → try Nominatim (only if enabled)
        if (!$this->enabled) {
            Log::info('Nominatim disabled, returning empty fallback result');
            return $fallbackResult;
        }

        $cacheKey = 'nominatim_search_' . md5($query . $limit);
        if (Cache::has($cacheKey)) {
            return Cache::get($cacheKey);
        }

        try {
            usleep(1000000); // Nominatim rate limit: 1 req/sec

            $response = Http::timeout(6)
                ->withHeaders(['User-Agent' => $this->userAgent])
                ->get("{$this->baseUrl}/search", [
                    'q' => $query,
                    'format' => 'json',
                    'limit' => $limit,
                    'countrycodes' => $this->country,
                    'addressdetails' => 1,
                    'accept-language' => $this->language,
                ]);

            if ($response->successful()) {
                $data = $response->json();
                if (!empty($data) && is_array($data)) {
                    $predictions = [];
                    foreach ($data as $item) {
                        $lat = $item['lat'] ?? null;
                        $lng = $item['lon'] ?? null;
                        if (!$lat || !$lng) continue;

                        $predictions[] = [
                            'description' => $item['display_name'] ?? $item['name'] ?? 'Unknown',
                            'place_id' => $item['place_id'] ?? null,
                            'lat' => (float) $lat,
                            'lng' => (float) $lng,
                            'type' => $item['type'] ?? 'location',
                            'address' => $item['address'] ?? [],
                            'priority' => 3, // Nominatim is lower priority than local
                            'distance_km' => 0,
                            'region' => 'Nominatim',
                        ];
                    }

                    if (!empty($predictions)) {
                        $result = [
                            'success' => true,
                            'predictions' => array_slice($predictions, 0, $limit),
                            'total' => count($predictions),
                            'source' => 'nominatim',
                        ];
                        Cache::put($cacheKey, $result, 300);
                        return $result;
                    }
                }
            }

            Log::warning('Nominatim returned no usable results', ['query' => $query]);
            // ✅ Return EMPTY fallback, not error
            return [
                'success' => true,
                'predictions' => [],
                'total' => 0,
                'source' => 'nominatim_empty',
            ];

        } catch (\Exception $e) {
            Log::error('Nominatim search exception: ' . $e->getMessage());
            // ✅ NEVER fail — return empty success so frontend doesn't crash
            return [
                'success' => true,
                'predictions' => [],
                'total' => 0,
                'source' => 'nominatim_error',
            ];
        }
    }

    public function reverseGeocode($lat, $lng)
    {
        // Try Nominatim first (it has best reverse geocoding)
        if ($this->enabled) {
            $cacheKey = 'nominatim_reverse_' . md5($lat . $lng);
            if (Cache::has($cacheKey)) return Cache::get($cacheKey);

            try {
                usleep(1000000);
                $response = Http::timeout(5)
                    ->withHeaders(['User-Agent' => $this->userAgent])
                    ->get("{$this->baseUrl}/reverse", [
                        'lat' => $lat,
                        'lon' => $lng,
                        'format' => 'json',
                        'zoom' => 18,
                        'addressdetails' => 1,
                        'accept-language' => $this->language,
                    ]);

                if ($response->successful()) {
                    $data = $response->json();
                    if (!empty($data['display_name'])) {
                        $result = [
                            'success' => true,
                            'address' => $data['display_name'],
                            'lat' => $lat,
                            'lng' => $lng,
                            'source' => 'nominatim',
                        ];
                        Cache::put($cacheKey, $result, 3600);
                        return $result;
                    }
                }
            } catch (\Exception $e) {
                Log::error('Nominatim reverse error: ' . $e->getMessage());
            }
        }

        // ✅ Fallback: format as coordinates
        return [
            'success' => true,
            'address' => "{$lat}, {$lng}",
            'lat' => $lat,
            'lng' => $lng,
            'source' => 'coordinates',
        ];
    }

    public function geocode($address)
    {
        // Try fallback first
        $result = $this->fallbackService->geocode($address);
        if ($result['success']) return $result;
        return ['success' => false, 'message' => 'Location not found'];
    }

    public function calculateDistance($originAddress, $destinationAddress)
    {
        // Fallback handles this entirely — it has real coords
        return $this->fallbackService->calculateDistance($originAddress, $destinationAddress);
    }

    public function calculateTripEstimate($originAddress, $destinationAddress, $vehicleId = null, $roundTrip = true)
    {
        return $this->fallbackService->calculateTripEstimate($originAddress, $destinationAddress, $vehicleId, $roundTrip);
    }
}